{
 "uid": "churnpulse",
 "title": "ChurnPulse \u2013 real-time pipeline",
 "schemaVersion": 39,
 "refresh": "10s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Live predictions / sec",
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 1,
     "color": {
      "mode": "fixed",
      "fixedColor": "#0F766E"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(churnpulse_predictions_total{kind=\"live\"}[1m]))"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Alerts (last hour)",
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#0F766E"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(increase(churnpulse_alerts_total[1h]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "p95 end-to-end latency",
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "decimals": 2,
     "color": {
      "mode": "fixed",
      "fixedColor": "#0F766E"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.95, sum(rate(churnpulse_end_to_end_seconds_bucket[1m])) by (le))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "Dashboards connected",
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "decimals": 0,
     "color": {
      "mode": "fixed",
      "fixedColor": "#0F766E"
     }
    },
    "overrides": []
   },
   "options": {
    "colorMode": "background",
    "graphMode": "area",
    "reduceOptions": {
     "calcs": [
      "lastNotNull"
     ]
    }
   },
   "targets": [
    {
     "refId": "A",
     "expr": "churnpulse_websocket_clients"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Predictions per second",
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(churnpulse_predictions_total[1m])) by (kind)",
     "legendFormat": "{{kind}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Alerts per minute",
   "gridPos": {
    "x": 12,
    "y": 4,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(churnpulse_alerts_total[5m])) by (alert) * 60",
     "legendFormat": "{{alert}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "End-to-end latency (event -> stored)",
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(churnpulse_end_to_end_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(churnpulse_end_to_end_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "Flink scoring time per event",
   "gridPos": {
    "x": 12,
    "y": 12,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "histogram_quantile(0.5, sum(rate(churnpulse_flink_processing_seconds_bucket[1m])) by (le))",
     "legendFormat": "p50"
    },
    {
     "refId": "B",
     "expr": "histogram_quantile(0.95, sum(rate(churnpulse_flink_processing_seconds_bucket[1m])) by (le))",
     "legendFormat": "p95"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Flink records in / out per second",
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(flink_taskmanager_job_task_numRecordsInPerSecond)",
     "legendFormat": "in"
    },
    {
     "refId": "B",
     "expr": "sum(flink_taskmanager_job_task_numRecordsOutPerSecond)",
     "legendFormat": "out"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "Flink JVM heap used",
   "gridPos": {
    "x": 12,
    "y": 20,
    "w": 12,
    "h": 8
   },
   "datasource": {
    "type": "prometheus",
    "uid": "prometheus"
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes",
     "custom": {
      "lineWidth": 2,
      "fillOpacity": 12
     }
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(flink_taskmanager_Status_JVM_Memory_Heap_Used)",
     "legendFormat": "taskmanager"
    },
    {
     "refId": "B",
     "expr": "sum(flink_jobmanager_Status_JVM_Memory_Heap_Used)",
     "legendFormat": "jobmanager"
    }
   ]
  }
 ],
 "tags": [
  "churnpulse"
 ]
}